<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug/test-only override of the main network security config. Cleartext is
  allowed ONLY to loopback so the on-device update-handoff fixture (a local test
  server reached via adb reverse) can serve the manifest and APK. Release builds
  get the strict main config: cleartext denied everywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
