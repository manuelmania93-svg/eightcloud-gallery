<?xml version="1.0" encoding="utf-8"?>
<!--
  Production update traffic is HTTPS to the release host. Cleartext is permitted
  ONLY to loopback so the CI update-flow harness can serve fixtures through
  adb reverse (http://127.0.0.1:8799).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
