<?xml version="1.0" encoding="utf-8"?>
<!--
  Production policy: cleartext denied everywhere. Update traffic is HTTPS to the
  release host. The loopback exception the CI fixture needs lives in the debug
  source set's override of this file (app/src/debug/res/xml/).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
